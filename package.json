{
  "name": "airdrop-lite",
  "private": true,
  "version": "0.0.1-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "go run ./server serve",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build:web": "vite build",
    "build:server": "go build -trimpath -o dist-server/airdrop-lite ./server",
    "build": "npm run build:web && npm run build:server",
    "start": "./dist-server/airdrop-lite serve",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && go test ./...",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}
