# 默认使用 docker-compose.yml 中固定的发布版本；需要时可取消注释覆盖。
# AIRDROP_IMAGE=hwangzhun/airdrop-lite:v0.0.1-beta.2

# 网站通过 Cloudflare Tunnel 访问时的完整 HTTPS origin；多个值用逗号分隔。
ALLOWED_ORIGINS=https://airdrop.example.com

# Cloudflare Dashboard > Networking > Tunnels 中的远程管理 Tunnel Token。
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Cloudflare Realtime TURN Key 的 ID 和 API Token，只保存在服务端。
CLOUDFLARE_TURN_KEY_ID=replace-with-turn-key-id
CLOUDFLARE_TURN_API_TOKEN=replace-with-turn-api-token

# 短期 TURN 凭据有效期，单位秒，默认 2 小时。
CLOUDFLARE_TURN_TTL=7200
