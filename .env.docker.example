# 网站通过反向代理访问时填写完整 HTTPS origin；多个值用逗号分隔。
ALLOWED_ORIGINS=https://airdrop.example.com

# TURN_HOST 必须能从客户端解析到部署机器，通常与网站域名相同。
TURN_HOST=airdrop.example.com

# Docker 宿主机的固定公网 IPv4 地址。
TURN_EXTERNAL_IP=203.0.113.10

# 使用 openssl rand -hex 32 生成，至少 24 个字符。
TURN_SECRET=replace-with-a-long-random-secret

TURN_REALM=airdrop.example.com
